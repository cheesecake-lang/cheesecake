# ============================================
# TEST 14: Checkpoint Cost Persistence
# ============================================
PRINT "============================================"
PRINT "TEST 14: Cost Persistence with Checkpoints"
PRINT "============================================"

CHECKPOINT "cost-test-checkpoint":
  SAVE: {result, r1, r2, r3}
END CHECKPOINT

PRINT "Checkpoint saved"
PRINT "  Cost data included: ~$0.030"
PRINT ""
PRINT "On resume:"
PRINT "  Cost state restored"
PRINT "  Prevents double-counting"
PRINT "  Accurate cost tracking maintained"
PRINT ""
PRINT "✓ Cost persistence validated"
PRINT ""


# ============================================
# INTEGRATION TEST: Full History Workflow
# ============================================

TEST "Integration: Full history workflow":
  # 1. Get initial history count
  MOCK GET_HISTORY RETURNS []
  VAR initial_history = GET_HISTORY(limit: 100)
  VAR initial_count = LENGTH(initial_history)

  # 2. After execution, history should increase
  MOCK GET_HISTORY RETURNS [
    {id: "new01", program: "test.cheesecake", status: "success"}
  ]
  VAR after_exec = GET_HISTORY(limit: 100)

  ASSERT LENGTH(after_exec) > 0

  # 3. Get execution details
  MOCK GET_EXECUTION RETURNS {
    id: "new01",
    program: "test.cheesecake",
    status: "success",
    inputs: {test_input: "value"},
    outputs: {test_output: "result"}
  }
  VAR details = GET_EXECUTION(id: "new01")

  ASSERT details.inputs.test_input == "value"
  ASSERT details.outputs.test_output == "result"

  # 4. Clear test entries
  MOCK CLEAR_HISTORY RETURNS 1
  VAR cleared = CLEAR_HISTORY(program: "test.cheesecake")

  ASSERT cleared >= 0

  LOG SUCCESS: "Full history workflow test complete"
END TEST


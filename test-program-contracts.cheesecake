# ============================================
# Test Workflow: Program Contracts & Composition
# Purpose: Test INPUT, OUTPUT, USE features
# ============================================

# ============================================
# TEST 1: INPUT Declaration (Required)
# ============================================
PRINT "============================================"
PRINT "TEST 1: INPUT Declaration (Required)"
PRINT "============================================"

# This program expects a required input
# When called without 'topic', should error
# INPUT topic: "The subject to research"

PRINT "INPUT declares required parameters"
PRINT "Syntax: INPUT name: \"description\""
PRINT "Required inputs have no DEFAULT"
PRINT ""

# ============================================
# TEST 2: INPUT Declaration (Optional with DEFAULT)
# ============================================
PRINT "============================================"
PRINT "TEST 2: INPUT Declaration (Optional with DEFAULT)"
PRINT "============================================"

# Optional inputs have DEFAULT values
# INPUT depth: "Research depth" DEFAULT: "medium"
# INPUT max_results: "Max results" DEFAULT: 10

PRINT "Optional INPUT with DEFAULT:"
PRINT "  INPUT depth: \"Research depth\" DEFAULT: \"medium\""
PRINT "  INPUT max_results: \"Max results\" DEFAULT: 10"
PRINT ""

# ============================================
# TEST 3: OUTPUT Declaration
# ============================================
PRINT "============================================"
PRINT "TEST 3: OUTPUT Declaration"
PRINT "============================================"

VAR research_data = "Sample research findings about AI"
VAR source_list = ["source1.com", "source2.org", "source3.edu"]

# OUTPUT binds values to be returned
OUTPUT findings = research_data
OUTPUT sources = source_list
OUTPUT metadata = {
  generated: "2026-01-14",
  count: 3
}

PRINT "OUTPUT binds return values:"
PRINT "  OUTPUT findings = research_data"
PRINT "  OUTPUT sources = source_list"
PRINT "  OUTPUT metadata = {...}"
PRINT ""

# ============================================
# TEST 4: Multiple INPUT Types
# ============================================
PRINT "============================================"
PRINT "TEST 4: Multiple INPUT Types"
PRINT "============================================"

# INPUTs can be various types
# INPUT query: "Search query string"                    # String
# INPUT count: "Number of results" DEFAULT: 5          # Number
# INPUT enabled: "Enable feature" DEFAULT: TRUE        # Boolean
# INPUT tags: "Filter tags" DEFAULT: []                # Array
# INPUT config: "Configuration" DEFAULT: {mode: "fast"} # Object

PRINT "INPUT supports multiple types:"
PRINT "  String: INPUT query: \"Search query\""
PRINT "  Number: INPUT count: \"Count\" DEFAULT: 5"
PRINT "  Boolean: INPUT enabled: \"Enable\" DEFAULT: TRUE"
PRINT "  Array: INPUT tags: \"Tags\" DEFAULT: []"
PRINT "  Object: INPUT config: \"Config\" DEFAULT: {mode: \"fast\"}"
PRINT ""

# ============================================
# TEST 5: USE Statement (Local Path)
# ============================================
PRINT "============================================"
PRINT "TEST 5: USE Statement (Local Path)"
PRINT "============================================"

# USE imports a program for composition
# USE "./research-workflow.cheesecake" AS research
# USE "./writer-workflow.cheesecake" AS writer

PRINT "USE imports programs:"
PRINT "  USE \"./research.cheesecake\" AS research"
PRINT "  USE \"./writer.cheesecake\" AS writer"
PRINT ""

# ============================================
# TEST 6: USE Statement (Registry - Future)
# ============================================
PRINT "============================================"
PRINT "TEST 6: USE Statement (Registry - Future)"
PRINT "============================================"

# Registry imports use @namespace/name format
# USE "@acme/data-processor"
# USE "@stdlib/text-utils" AS utils

PRINT "Registry imports:"
PRINT "  USE \"@acme/data-processor\""
PRINT "  USE \"@stdlib/text-utils\" AS utils"
PRINT ""

# ============================================
# TEST 7: Program Invocation Syntax
# ============================================
PRINT "============================================"
PRINT "TEST 7: Program Invocation Syntax"
PRINT "============================================"

# After USE, call with RUN program(args)
# VAR result = RUN research(topic: "quantum computing")
# VAR result2 = RUN research(topic: "AI", depth: "deep")

PRINT "Invoke programs with RUN:"
PRINT "  VAR result = RUN research(topic: \"quantum\")"
PRINT "  VAR result = RUN research(topic: \"AI\", depth: \"deep\")"
PRINT ""

# ============================================
# TEST 8: Accessing Program Outputs
# ============================================
PRINT "============================================"
PRINT "TEST 8: Accessing Program Outputs"
PRINT "============================================"

# Results are objects with OUTPUT properties
# VAR result = RUN research(topic: "AI")
# PRINT result.findings
# PRINT result.sources
# VAR data = result.metadata

PRINT "Access outputs as properties:"
PRINT "  result.findings"
PRINT "  result.sources"
PRINT "  result.metadata.generated"
PRINT ""

# ============================================
# TEST 9: Parallel Program Execution
# ============================================
PRINT "============================================"
PRINT "TEST 9: Parallel Program Execution"
PRINT "============================================"

# Programs can run in parallel
# PARALLEL:
#   VAR r1 = RUN research(topic: "AI")
#   VAR r2 = RUN research(topic: "ML")
#   VAR r3 = RUN research(topic: "NLP")
# END PARALLEL

PRINT "Programs run in parallel:"
PRINT "  PARALLEL:"
PRINT "    VAR r1 = RUN research(topic: \"AI\")"
PRINT "    VAR r2 = RUN research(topic: \"ML\")"
PRINT "  END PARALLEL"
PRINT ""

# ============================================
# TEST 10: Program Composition Chain
# ============================================
PRINT "============================================"
PRINT "TEST 10: Program Composition Chain"
PRINT "============================================"

# Programs can chain: output of one -> input of another
# USE "./research.cheesecake" AS research
# USE "./writer.cheesecake" AS writer
#
# VAR r = RUN research(topic: "quantum")
# VAR article = RUN writer(content: r.findings, sources: r.sources)

PRINT "Chain programs together:"
PRINT "  VAR r = RUN research(topic: \"quantum\")"
PRINT "  VAR article = RUN writer("
PRINT "    content: r.findings,"
PRINT "    sources: r.sources"
PRINT "  )"
PRINT ""

# ============================================
# TEST 11: Error Handling in Program Calls
# ============================================
PRINT "============================================"
PRINT "TEST 11: Error Handling in Program Calls"
PRINT "============================================"

# Programs can fail, use TRY/CATCH
# TRY:
#   VAR result = RUN risky_program(input: data)
# CATCH error:
#   LOG ERROR: "Program failed: {error.message}"
#   VAR result = fallback_value
# END TRY

PRINT "Handle program errors:"
PRINT "  TRY:"
PRINT "    VAR result = RUN program(input: data)"
PRINT "  CATCH error:"
PRINT "    LOG ERROR: \"Failed: {error.message}\""
PRINT "  END TRY"
PRINT ""

# ============================================
# TEST 12: Contract Validation
# ============================================
PRINT "============================================"
PRINT "TEST 12: Contract Validation"
PRINT "============================================"

# Missing required input -> ERROR
# Unknown input -> WARNING (ignored)
# Missing optional -> Uses DEFAULT

PRINT "Contract validation:"
PRINT "  Missing required: ERROR"
PRINT "  Unknown input: WARNING (ignored)"
PRINT "  Missing optional: Uses DEFAULT value"
PRINT ""

# ============================================
# TEST 13: INPUT as Variables
# ============================================
PRINT "============================================"
PRINT "TEST 13: INPUT as Variables"
PRINT "============================================"

# INPUT names become variables in program scope
# INPUT topic: "Subject"
# INPUT depth: "Depth" DEFAULT: "medium"
#
# # Use directly as variables:
# VAR result = RUN SESSION(agent):
#   TASK: "Research {topic} at {depth} depth"

PRINT "INPUTs available as variables:"
PRINT "  INPUT topic: \"Subject\""
PRINT "  TASK: \"Research {topic}\"  # Uses input value"
PRINT ""

# ============================================
# TEST 14: Complete Program Example
# ============================================
PRINT "============================================"
PRINT "TEST 14: Complete Program Example"
PRINT "============================================"

PRINT "Complete reusable program:"
PRINT ""
PRINT "  # research-workflow.cheesecake"
PRINT "  INPUT topic: \"Subject to research\""
PRINT "  INPUT depth: \"Depth\" DEFAULT: \"medium\""
PRINT ""
PRINT "  AGENT Researcher:"
PRINT "    MODEL: sonnet"
PRINT "    PROMPT: \"You research thoroughly.\""
PRINT ""
PRINT "  VAR researcher = NEW Researcher()"
PRINT "  VAR findings = RUN SESSION(researcher):"
PRINT "    TASK: \"Research {topic} at {depth}\""
PRINT ""
PRINT "  OUTPUT findings = findings"
PRINT "  OUTPUT timestamp = NOW()"
PRINT ""

# ============================================
# TEST 15: USE vs IMPORT Comparison
# ============================================
PRINT "============================================"
PRINT "TEST 15: USE vs IMPORT Comparison"
PRINT "============================================"

PRINT "IMPORT vs USE:"
PRINT ""
PRINT "  IMPORT (code inclusion):"
PRINT "    IMPORT \"agents.cheesecake\" AS agents"
PRINT "    VAR a = NEW agents.Researcher()"
PRINT ""
PRINT "  USE (program composition):"
PRINT "    USE \"./research.cheesecake\" AS research"
PRINT "    VAR result = RUN research(topic: \"AI\")"
PRINT ""
PRINT "  IMPORT: Include definitions (agents, skills, functions)"
PRINT "  USE: Call complete programs with contracts"
PRINT ""

# ============================================
# TEST 16: Registry URL Resolution
# ============================================
PRINT "============================================"
PRINT "TEST 16: Registry URL Resolution"
PRINT "============================================"

# Registry paths start with @
# USE "@workflows/web-researcher"
# USE "@acme/data-processor" AS processor

PRINT "Registry URL resolution:"
PRINT ""
PRINT "  Path format: @<handle>/<slug>"
PRINT ""
PRINT "  Examples:"
PRINT "    USE \"@workflows/web-researcher\""
PRINT "    → Fetches: https://registry.cheesecake.dev/@workflows/web-researcher"
PRINT ""
PRINT "    USE \"@acme/data-processor\" AS processor"
PRINT "    → Fetches: https://registry.cheesecake.dev/@acme/data-processor"
PRINT ""
PRINT "  Resolution steps:"
PRINT "    1. Parse @handle/slug"
PRINT "    2. Check cache (.cheesecake/cache/@handle/slug)"
PRINT "    3. If not cached: fetch from registry"
PRINT "    4. Parse and validate program"
PRINT "    5. Register in ImportRegistry"
PRINT ""

# ============================================
# TEST 17: Destructuring Outputs
# ============================================
PRINT "============================================"
PRINT "TEST 17: Destructuring Outputs"
PRINT "============================================"

# Instead of:
# VAR result = RUN research(topic: "AI")
# PRINT result.findings
# PRINT result.sources

# You can destructure:
# VAR { findings, sources } = RUN research(topic: "AI")
# PRINT findings
# PRINT sources

PRINT "Destructuring outputs:"
PRINT ""
PRINT "  Standard access:"
PRINT "    VAR result = RUN research(topic: \"AI\")"
PRINT "    PRINT result.findings"
PRINT "    PRINT result.sources"
PRINT ""
PRINT "  Destructured:"
PRINT "    VAR { findings, sources } = RUN research(topic: \"AI\")"
PRINT "    PRINT findings    # Direct access"
PRINT "    PRINT sources     # Direct access"
PRINT ""
PRINT "  With rename:"
PRINT "    VAR { findings AS data, sources AS refs } = RUN research(topic: \"AI\")"
PRINT "    PRINT data        # Renamed from 'findings'"
PRINT "    PRINT refs        # Renamed from 'sources'"
PRINT ""
PRINT "  Partial destructuring:"
PRINT "    VAR { findings } = RUN research(topic: \"AI\")"
PRINT "    # Only 'findings' extracted, other outputs ignored"
PRINT ""

# ============================================
# TEST 18: Registry Caching
# ============================================
PRINT "============================================"
PRINT "TEST 18: Registry Caching"
PRINT "============================================"

# Programs from registry are cached locally
# Cache structure: .cheesecake/cache/@handle/slug

PRINT "Registry caching:"
PRINT ""
PRINT "  Cache location: .cheesecake/cache/"
PRINT ""
PRINT "  Cache structure:"
PRINT "    .cheesecake/"
PRINT "      cache/"
PRINT "        @workflows/"
PRINT "          web-researcher           # Program content"
PRINT "          web-researcher.meta      # Metadata (timestamp, version)"
PRINT "        @stdlib/"
PRINT "          text-utils"
PRINT "          text-utils.meta"
PRINT ""
PRINT "  Cache behavior:"
PRINT "    - Default TTL: 24 hours"
PRINT "    - Auto-refresh on expiry"
PRINT "    - Falls back to cache if network fails"
PRINT ""

# ============================================
# TEST 19: Force Refresh
# ============================================
PRINT "============================================"
PRINT "TEST 19: Force Refresh"
PRINT "============================================"

# REFRESH keyword bypasses cache
# USE "@workflows/web-researcher" REFRESH

PRINT "Force refresh from registry:"
PRINT ""
PRINT "  Normal (uses cache):"
PRINT "    USE \"@workflows/web-researcher\""
PRINT ""
PRINT "  Force refresh (bypass cache):"
PRINT "    USE \"@workflows/web-researcher\" REFRESH"
PRINT ""
PRINT "  REFRESH behavior:"
PRINT "    1. Ignores local cache"
PRINT "    2. Fetches directly from registry"
PRINT "    3. Updates cache with new content"
PRINT "    4. Registers program"
PRINT ""

# ============================================
# TEST 20: Import Registry Structure
# ============================================
PRINT "============================================"
PRINT "TEST 20: Import Registry Structure"
PRINT "============================================"

PRINT "ImportRegistry structure:"
PRINT ""
PRINT "  ImportRegistry = {"
PRINT "    \"web-researcher\": {"
PRINT "      source: \"@workflows/web-researcher\","
PRINT "      source_type: \"REGISTRY\","
PRINT "      resolved_url: \"https://registry.cheesecake.dev/@workflows/web-researcher\","
PRINT "      contract: {"
PRINT "        inputs: [{name: \"topic\", required: true}, ...],"
PRINT "        outputs: [\"findings\", \"sources\", \"metadata\"]"
PRINT "      },"
PRINT "      cached_at: \"2026-01-14T10:30:00Z\","
PRINT "      version: \"1.2.0\""
PRINT "    },"
PRINT "    \"content-writer\": {"
PRINT "      source: \"./content-writer.cheesecake\","
PRINT "      source_type: \"LOCAL\","
PRINT "      resolved_url: null,"
PRINT "      contract: {...}"
PRINT "    }"
PRINT "  }"
PRINT ""

# ============================================
# TEST 21: Complete Registry Composition
# ============================================
PRINT "============================================"
PRINT "TEST 21: Complete Registry Composition"
PRINT "============================================"

PRINT "Complete composition with registry programs:"
PRINT ""
PRINT "  # iterative-research.cheesecake"
PRINT "  USE \"@workflows/web-researcher\" AS researcher"
PRINT "  USE \"@workflows/quality-reviewer\" AS reviewer"
PRINT ""
PRINT "  INPUT topic: \"What to investigate\""
PRINT ""
PRINT "  VAR result = NULL"
PRINT "  VAR review = NULL"
PRINT ""
PRINT "  LOOP UNTIL **{review.score} >= 8** MAX 3:"
PRINT "    result = RUN researcher(topic: topic)"
PRINT "    review = RUN reviewer(content: result.findings)"
PRINT "  END LOOP"
PRINT ""
PRINT "  OUTPUT findings = result.findings"
PRINT "  OUTPUT sources = result.sources"
PRINT "  OUTPUT final_score = review.score"
PRINT ""

# ============================================
# TEST 22: Invoking with Destructuring
# ============================================
PRINT "============================================"
PRINT "TEST 22: Invoking with Destructuring"
PRINT "============================================"

PRINT "Using composed program with destructuring:"
PRINT ""
PRINT "  USE \"@workflows/iterative-research\" AS deep_research"
PRINT ""
PRINT "  VAR { findings, sources, final_score } = RUN deep_research("
PRINT "    topic: \"machine learning trends\""
PRINT "  )"
PRINT ""
PRINT "  IF final_score >= 8:"
PRINT "    PRINT \"High quality research!\""
PRINT "    PRINT findings"
PRINT "  ELSE:"
PRINT "    PRINT \"Quality threshold not met\""
PRINT "  END IF"
PRINT ""

# ============================================
# TEST 23: Registry Error Handling
# ============================================
PRINT "============================================"
PRINT "TEST 23: Registry Error Handling"
PRINT "============================================"

PRINT "Registry error scenarios:"
PRINT ""
PRINT "  Program not found (404):"
PRINT "    USE \"@workflows/nonexistent\""
PRINT "    # ERROR: Program @workflows/nonexistent not found in registry"
PRINT ""
PRINT "  Network error with cache:"
PRINT "    USE \"@workflows/web-researcher\"  # Network fails"
PRINT "    # WARN: Registry unavailable, using cached version"
PRINT ""
PRINT "  Network error without cache:"
PRINT "    USE \"@workflows/new-program\"  # Network fails, no cache"
PRINT "    # ERROR: Failed to fetch @workflows/new-program: network error"
PRINT ""
PRINT "  Invalid program in registry:"
PRINT "    USE \"@workflows/malformed\""
PRINT "    # ERROR: Failed to parse @workflows/malformed: syntax error at line 5"
PRINT ""

